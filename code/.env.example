# Sao chép thành .env (cùng thư mục docker-compose.yml) rồi đổi mật khẩu TRƯỚC lần chạy đầu tiên.
# Role DB chỉ được tạo khi volume Postgres mới tạo (docker/postgres/init/01-roles.sh).
# Các script trong scripts/ cũng đọc file này.

# Superuser, chủ sở hữu bảng: Flyway + script replication
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password

# Role ứng dụng Spring Boot (không phải superuser). Ở chi nhánh chỉ được ghi bảng giao dịch.
APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_app_password

# Role mà subscription dùng để đọc publisher
REPL_DB_USER=erp_repl
REPL_DB_PASSWORD=erp_repl_password
